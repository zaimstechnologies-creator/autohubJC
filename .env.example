# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Admin Login (keep these values in .env.local / deployment secrets; never commit them)
AUTH_USERNAME=replace-with-your-admin-id
# Run `node scripts/hash-password.cjs` and paste its output here.
AUTH_PASSWORD_HASH=replace-with-generated-scrypt-hash
# Generate with `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# YouTube Playlist Configuration
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=PLfWI-z1AjtsA
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=3m4ApRBJmlo
